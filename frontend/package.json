{
  "name": "perfectcorpai",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "types:api": "openapi-typescript https://api.glowverse.com/openapi.json -o src/types/api.ts",
    "types:generate": "openapi-typescript http://localhost:3000/api/openapi.json -o src/types/api-generated.ts",
    "types:generate:prod": "openapi-typescript https://api.glowverse.com/api/openapi.json -o src/types/api-generated.ts",
    "types:watch": "npm run types:generate -- --watch",
    "types:check": "tsc --noEmit && npm run types:generate && tsc --noEmit",
    "audit:contrast": "node scripts/auditContrast.js",
    "assets:optimize": "node scripts/optimizeAssets.js",
    "assets:verify": "node scripts/checkImages.js",
    "screenshots:verify": "node scripts/checkScreenshots.js",
    "eas:verify": "node scripts/verifyEas.js",
    "screenshots:prepare": "node scripts/prepareScreenshotDirs.js",
    "audit:api": "node scripts/auditApiCoverage.js",
    "test:integration": "RUN_INTEGRATION=true jest src/services/api/__tests__/integration.test.ts -i",
    "build:dev": "eas build --profile development --platform all",
    "build:prod": "eas build --profile production --platform all",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "release": "npm run build:prod && npm run submit:ios && npm run submit:android",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "e2e:ios:build": "detox build --configuration ios.sim.debug",
    "e2e:ios:test": "detox test --configuration ios.sim.debug",
    "e2e:android:build": "detox build --configuration android.emu.debug",
    "e2e:android:test": "detox test --configuration android.emu.debug",
    "e2e:test": "detox test",
    "e2e:test:ci": "detox test --configuration ios.sim.release --cleanup"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@ptomasroos/react-native-multi-slider": "^2.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/messaging": "^23.8.6",
    "@react-navigation/bottom-tabs": "^7.12.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/stack": "^7.7.1",
    "@stripe/stripe-react-native": "^0.33.0",
    "@tanstack/query-async-storage-persister": "^5.90.22",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.90.22",
    "axios": "^1.13.5",
    "expo": "~54.0.33",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "^18.0.13",
    "expo-device": "~6.0.2",
    "expo-face-detector": "^13.0.2",
    "expo-file-system": "~19.0.21",
    "expo-firebase-analytics": "^8.0.0",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "^8.0.11",
    "expo-local-authentication": "~14.0.1",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.29.10",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~3.0.9",
    "fuse.js": "^7.1.0",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^4.1.2",
    "react-native-paper": "^5.15.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-share": "^12.2.5",
    "react-native-svg": "15.12.1",
    "react-native-vision-camera": "^4.7.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "^1.6.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^54.0.10",
    "detox": "^20.17.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "openapi-typescript": "^7.13.0",
    "sharp": "^0.33.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
