{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "dev",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_BASE_URL": "http://localhost:5000/api/v1",
        "CLOUDINARY_CLOUD_NAME": "dev-cloud",
        "ENVIRONMENT": "development",
        "STRIPE_PUBLISHABLE_KEY": "pk_test_xxx",
        "STRIPE_MERCHANT_ID": "merchant.com.glowverse.dev",
        "PERFECT_CORP_API_KEY": "replace_me_dev",
        "ANALYTICS_ID": "dev-analytics",
        "SENTRY_DSN": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "API_BASE_URL": "https://staging-api.glowverse.com/api/v1",
        "CLOUDINARY_CLOUD_NAME": "staging-cloud",
        "ENVIRONMENT": "staging",
        "STRIPE_PUBLISHABLE_KEY": "pk_test_xxx",
        "STRIPE_MERCHANT_ID": "merchant.com.glowverse.staging",
        "PERFECT_CORP_API_KEY": "replace_me_preview",
        "ANALYTICS_ID": "preview-analytics",
        "SENTRY_DSN": ""
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "API_BASE_URL": "https://api.glowverse.com/api/v1",
        "CLOUDINARY_CLOUD_NAME": "prod-cloud",
        "ENVIRONMENT": "production",
        "STRIPE_PUBLISHABLE_KEY": "pk_live_xxx",
        "STRIPE_MERCHANT_ID": "merchant.com.glowverse",
        "PERFECT_CORP_API_KEY": "replace_me_prod",
        "ANALYTICS_ID": "prod-analytics",
        "SENTRY_DSN": ""
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./secrets/google-play-key.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "fill-your-apple-id@example.com",
        "ascAppId": "YOUR_ASC_APP_ID"
      }
    }
  }
}
