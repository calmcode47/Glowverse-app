generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String?
  avatar        String?
  role          String    @default("USER")
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  profile       UserProfile?
  analyses      Analysis[]
  favorites     Favorite[]
  tryOns        VirtualTryOn[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String?
  dateOfBirth DateTime?
  gender      String?
  skinType    String?
  skinTone    String?
  preferences String?
  totalAnalyses    Int @default(0)
  totalTryOns      Int @default(0)
  favoriteProducts Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
  @@index([userId])
}

model Analysis {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  status      String        @default("PENDING")
  originalImageUrl          String
  originalImagePublicId     String
  processedImageUrl         String?
  processedImagePublicId    String?
  results     String?
  metadata    String?
  errorMessage String?
  processingTime Int?
  perfectCorpAnalysisId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("analyses")
  @@index([userId, type])
  @@index([createdAt])
}

model VirtualTryOn {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  status      String   @default("PENDING")
  originalImageUrl          String
  originalImagePublicId     String
  resultImageUrl            String?
  resultImagePublicId       String?
  productId   String?
  productName String?
  productBrand String?
  productCategory String?
  intensity   Float    @default(1.0)
  results     String?
  metadata    String?
  errorMessage String?
  processingTime Int?
  perfectCorpTryOnId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("virtual_try_ons")
  @@index([userId, type])
  @@index([createdAt])
}

model Favorite {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  productBrand String?
  productCategory String?
  productImageUrl String?
  price       Float?
  notes       String?
  tags        String   @default("[]")
  createdAt   DateTime @default(now())

  @@unique([userId, productId])
  @@map("favorites")
  @@index([userId])
}

model ProductRecommendation {
  id          String   @id @default(uuid())
  productId   String   @unique
  name        String
  brand       String
  category    String
  description String?
  price       Float?
  imageUrl    String?
  rating      Float?
  suitableForSkinTypes String   @default("[]")
  suitableForSkinTones String   @default("[]")
  concerns    String   @default("[]")
  perfectCorpProductId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("product_recommendations")
  @@index([category])
}

model ApiUsage {
  id          String   @id @default(uuid())
  endpoint    String
  method      String
  statusCode  Int
  duration    Int
  ipAddress   String?
  userAgent   String?
  userId      String?
  createdAt   DateTime @default(now())

  @@map("api_usage")
  @@index([endpoint])
  @@index([createdAt])
}
