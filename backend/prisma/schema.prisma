generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum ProductCategory {
  SKINCARE
  MAKEUP
  HAIRCARE
  BODYCARE
  FRAGRANCE
  TOOLS
  SUPPLEMENTS
  WELLNESS
  MENS_GROOMING
  GIFT_SETS
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_PROCESSING
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  ANALYSIS_COMPLETE
  TRYON_COMPLETE
  PROMOTION
  SYSTEM
  ACCOUNT
  PRODUCT_RESTOCKED
  PRICE_DROP
  GENERAL
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PromotionType {
  GENERAL
  FIRST_ORDER
  SEASONAL
  FLASH_SALE
  REFERRAL
  LOYALTY
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ReferralStatus {
  PENDING
  REGISTERED
  COMPLETED
  EXPIRED
}

enum ActivityType {
  CARDIO
  STRENGTH
  YOGA
  STRETCHING
  SPORTS
  WALKING
  RUNNING
  CYCLING
  SWIMMING
  OTHER
}

enum IntensityLevel {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum GoalType {
  WEEKLY_MINUTES
  WEEKLY_SESSIONS
  MONTHLY_CALORIES
  DAILY_STEPS
  WEEKLY_DISTANCE
  CUSTOM
}

enum GoalPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum GuideCategory {
  SKINCARE_ROUTINE
  HAIRCARE
  GROOMING_TIPS
  MAKEUP_TUTORIAL
  PRODUCT_USAGE
  WELLNESS
  NUTRITION
  LIFESTYLE
  GENERAL
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ============================================
// USER MODELS
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String?
  avatar        String?
  role          String    @default("USER")
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  
  // Relations
  profile       UserProfile?
  analyses      Analysis[]
  favorites     Favorite[]
  tryOns        VirtualTryOn[]
  refreshTokens RefreshToken[]
  cart          Cart?
  orders        Order[]
  notifications Notification[]
  promotionUsages PromotionUsage[]
  referralsGiven  Referral[] @relation("ReferrerRelation")
  referralUsed    Referral?  @relation("RefereeRelation")
  referralCode    String?    @unique
  referralEarnings Float     @default(0)
  fitnessActivities FitnessActivity[]
  fitnessGoals      FitnessGoal[]
  authoredGuides    Guide[]
  guideLikes        GuideLike[]
  guideBookmarks    GuideBookmark[]
  guideComments     GuideComment[]
  productReviews    ProductReview[]

  @@map("users")
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String?
  dateOfBirth DateTime?
  gender      String?
  skinType    String?
  skinTone    String?
  preferences String?
  totalAnalyses    Int @default(0)
  totalTryOns      Int @default(0)
  favoriteProducts Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
  @@index([userId])
}

model Analysis {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  status      String        @default("PENDING")
  originalImageUrl          String
  originalImagePublicId     String
  processedImageUrl         String?
  processedImagePublicId    String?
  results     String?
  metadata    String?
  errorMessage String?
  processingTime Int?
  perfectCorpAnalysisId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("analyses")
  @@index([userId, type])
  @@index([createdAt])
}

model VirtualTryOn {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  status      String   @default("PENDING")
  originalImageUrl          String
  originalImagePublicId     String
  resultImageUrl            String?
  resultImagePublicId       String?
  productId   String?
  productName String?
  productBrand String?
  productCategory String?
  intensity   Float    @default(1.0)
  results     String?
  metadata    String?
  errorMessage String?
  processingTime Int?
  perfectCorpTryOnId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("virtual_try_ons")
  @@index([userId, type])
  @@index([createdAt])
}

model Favorite {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Snapshot fields kept for backward compatibility or quick access, but defined relation is better
  productName String
  productBrand String?
  productCategory String?
  productImageUrl String?
  price       Float?
  notes       String?
  tags        String   @default("[]")
  createdAt   DateTime @default(now())

  @@unique([userId, productId])
  @@map("favorites")
  @@index([userId])
}

model ProductRecommendation {
  id          String   @id @default(uuid())
  productId   String   @unique
  name        String
  brand       String
  category    String
  description String?
  price       Float?
  imageUrl    String?
  rating      Float?
  suitableForSkinTypes String   @default("[]")
  suitableForSkinTones String   @default("[]")
  concerns    String   @default("[]")
  perfectCorpProductId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("product_recommendations")
  @@index([category])
}

model ApiUsage {
  id          String   @id @default(uuid())
  endpoint    String
  method      String
  statusCode  Int
  duration    Int
  ipAddress   String?
  userAgent   String?
  userId      String?
  createdAt   DateTime @default(now())

  @@map("api_usage")
  @@index([endpoint])
  @@index([createdAt])
}

// ============================================
// E-COMMERCE MODELS
// ============================================

/// Product model for the e-commerce catalog
/// Stores all product information including pricing, inventory, and metadata
model Product {
  id                    String          @id @default(uuid())
  name                  String
  slug                  String          @unique
  description           String // Detailed product description
  shortDescription      String? // Brief summary
  brand                 String
  category              ProductCategory
  subCategory           String?
  
  // Pricing (using Decimal for precision)
  price                 Decimal         @db.Decimal(10, 2)
  compareAtPrice        Decimal?        @db.Decimal(10, 2)
  currency              String          @default("USD")
  
  // Inventory
  stock                 Int             @default(0)
  lowStockThreshold     Int             @default(10)
  sku                   String?         @unique
  barcode               String?
  
  // Physical specs
  weight                Decimal?        @db.Decimal(10, 2)
  dimensions            String?         // JSON: {length, width, height}
  
  // Content & Metadata (JSON strings)
  images                String          // JSON array of image URLs
  thumbnailUrl          String
  tags                  String          // JSON array of search tags
  ingredients           String?
  benefits              String          // JSON array of benefits
  howToUse              String?
  
  // Status
  isActive              Boolean         @default(true)
  isFeatured            Boolean         @default(false)
  isNewArrival          Boolean         @default(false)
  isBestseller          Boolean         @default(false)
  
  // Analytics & Stats
  rating                Decimal?        @db.Decimal(3, 2)
  reviewCount           Int             @default(0)
  viewCount             Int             @default(0)
  purchaseCount         Int             @default(0)
  
  // Integrations
  perfectCorpProductId  String?         // For AR try-on integration
  metadata              String?         // JSON for flexible additional data
  
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  publishedAt           DateTime?
  
  // Relations
  cartItems             CartItem[]
  orderItems            OrderItem[]
  favorites             Favorite[]
  reviews               ProductReview[]

  @@map("products")
  @@index([category, isActive])
  @@index([isFeatured, isActive])
  @@index([slug])
  @@index([sku])
  @@index([brand])
  @@index([createdAt])
  @@index([price])
  @@index([rating])
  @@index([category, price])
  @@index([category, rating])
}

/// Cart model - one cart per user
model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  
  subtotal  Decimal    @default(0) @db.Decimal(10, 2) // Calculated subtotal
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

/// CartItem model - items within a cart
/// Stores snapshot of price at time of addition
model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  quantity  Int      // 1-99
  price     Decimal  @db.Decimal(10, 2) // Snapshot price
  subtotal  Decimal  @db.Decimal(10, 2) // price * quantity
  
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@map("cart_items")
  @@index([cartId])
  @@index([productId])
}

/// Order model - stores customer orders
/// Includes full address and payment information
model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique  // ORD-YYYYMMDD-XXXXX
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  
  // Financials
  subtotal        Decimal       @db.Decimal(10, 2)
  tax             Decimal       @default(0) @db.Decimal(10, 2)
  shippingCost    Decimal       @default(0) @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  
  // Details (JSON strings)
  shippingAddress String        // JSON
  billingAddress  String?       // JSON
  paymentMethod   String
  paymentIntentId String?
  
  // Fulfillment
  trackingNumber  String?
  trackingUrl     String?
  estimatedDelivery DateTime?
  deliveredAt     DateTime?
  
  // Lifecycle
  cancelledAt     DateTime?
  refundedAt      DateTime?
  
  // Notes
  notes           String?
  internalNotes   String?
  metadata        String?
  
  items           OrderItem[]
  promotionUsage  PromotionUsage?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("orders")
  @@index([userId, createdAt])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

/// OrderItem model - line items within an order
/// Stores product snapshots to preserve order history even if product changes
model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  
  // Snapshots
  productName  String
  productImage String
  productSku   String?
  
  quantity     Int
  price        Decimal  @db.Decimal(10, 2)
  subtotal     Decimal  @db.Decimal(10, 2)
  tax          Decimal  @default(0) @db.Decimal(10, 2)
  discount     Decimal  @default(0) @db.Decimal(10, 2)
  total        Decimal  @db.Decimal(10, 2)
  
  createdAt    DateTime @default(now())

  @@map("order_items")
  @@index([orderId])
  @@index([productId])
}

// ============================================
// NOTIFICATION SYSTEM
// ============================================

/// Notification model - user notifications for orders, analysis, promotions, etc.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      NotificationType
  title     String
  message   String
  data      String?          // JSON: Additional context data
  
  isRead    Boolean          @default(false)
  readAt    DateTime?
  
  priority  NotificationPriority @default(NORMAL)
  
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  
  @@map("notifications")
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================
// PROMOTIONS & REFERRALS SYSTEM
// ============================================

/// Promotion model - discount codes and promotional campaigns
model Promotion {
  id          String    @id @default(uuid())
  code        String    @unique
  description String
  type        PromotionType
  
  // Discount details
  discountType      DiscountType
  discountValue     Float
  maxDiscount       Float?  // For percentage discounts
  minOrderValue     Float?  // Minimum order value
  
  // Applicability (stored as JSON strings)
  applicableCategories String  @default("[]") // JSON array of categories
  applicableProducts   String  @default("[]") // JSON array of product IDs
  
  // Limits
  usageLimit       Int?     // Total times can be used
  usageCount       Int      @default(0)
  
  // Validity
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(true)
  
  // Tracking
  usages       PromotionUsage[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@map("promotions")
  @@index([code])
  @@index([isActive, startDate, endDate])
}

/// PromotionUsage model - tracks each promotion redemption
model PromotionUsage {
  id           String    @id @default(uuid())
  promotionId  String
  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId      String?   @unique
  order        Order?    @relation(fields: [orderId], references: [id])
  
  discountAmount Float
  
  createdAt    DateTime  @default(now())
  
  @@map("promotion_usages")
  @@index([userId])
  @@index([promotionId])
}

/// Referral model - user referral tracking and rewards
model Referral {
  id           String    @id @default(uuid())
  referrerId   String
  referrer     User      @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId    String?   @unique
  referee      User?     @relation("RefereeRelation", fields: [refereeId], references: [id], onDelete: Cascade)
  
  code         String    @unique
  
  // Status
  status       ReferralStatus @default(PENDING)
  
  // Rewards
  referrerReward Float   @default(0)
  refereeReward  Float   @default(0)
  referrerPaid   Boolean @default(false)
  refereePaid    Boolean @default(false)
  
  // Tracking
  refereeEmail   String?  // Referee email before signup
  completedAt    DateTime?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@map("referrals")
  @@index([referrerId])
  @@index([code])
}

// ============================================
// FITNESS TRACKING SYSTEM
// ============================================

/// FitnessActivity model - track user workout and wellness activities
/// FitnessActivity model - track user workout and wellness activities
model FitnessActivity {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        ActivityType
  title       String?
  description String?
  
  // Duration and intensity
  durationMinutes Int
  intensity       IntensityLevel
  caloriesBurned  Int?
  
  // Additional metrics
  distance        Decimal? @db.Decimal(10, 2) // in km
  steps           Int?
  heartRate       Int?     // average BPM
  
  // Timing
  activityDate    DateTime
  startTime       DateTime?
  endTime         DateTime?
  
  // Notes
  notes           String?
  mood            String?   // How user felt
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("fitness_activities")
  @@index([userId, activityDate])
  @@index([userId, type])
}

/// FitnessGoal model - user fitness and wellness goals
/// FitnessGoal model - user fitness and wellness goals
model FitnessGoal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        GoalType
  title       String
  description String?
  
  target      Decimal  @db.Decimal(10, 2)
  current     Decimal  @default(0) @db.Decimal(10, 2)
  unit        String   // "minutes", "calories", "sessions", "steps"
  
  period      GoalPeriod
  
  startDate   DateTime
  endDate     DateTime
  
  isActive    Boolean  @default(true)
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("fitness_goals")
  @@index([userId, isActive])
  @@index([userId, period])
}

// ============================================
// GROOMING GUIDES & CONTENT SYSTEM
// ============================================

/// Guide model - educational content and tutorials
model Guide {
  id          String   @id @default(uuid())
  
  // Content
  title       String
  slug        String   @unique
  description String
  content     String   @db.Text
  excerpt     String?
  
  // Media
  thumbnailUrl String?
  images       String   @default("[]")
  videoUrl     String?
  
  // Categorization
  category    GuideCategory
  tags        String   @default("[]")
  difficulty  DifficultyLevel?
  
  // Duration
  readTime    Int?     // in minutes
  duration    Int?     // for routines/tutorials in minutes
  
  // Metadata
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  bookmarkCount Int    @default(0)
  shareCount  Int      @default(0)
  
  // Publishing
  isPublished Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  publishedAt DateTime?
  
  // Relations
  steps       GuideStep[]
  likes       GuideLike[]
  bookmarks   GuideBookmark[]
  comments    GuideComment[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("guides")
  @@index([category, isPublished])
  @@index([slug])
  @@index([tags])
  @@index([authorId])
  @@index([createdAt])
  @@index([publishedAt])
}

/// GuideStep model - individual steps in multi-step guides
model GuideStep {
  id          String   @id @default(uuid())
  guideId     String
  guide       Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  
  order       Int
  title       String
  content     String   @db.Text
  imageUrl    String?
  videoUrl    String?
  tips        String   @default("[]")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("guide_steps")
  @@index([guideId, order])
}

/// GuideLike model - user likes/favorites for guides
model GuideLike {
  id        String   @id @default(uuid())
  guideId   String
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([guideId, userId])
  @@map("guide_likes")
  @@index([userId])
}

model ProductReview {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rating    Int      // 1-5
  title     String?
  comment   String?  @db.Text
  images    String   @default("[]") // JSON array of image URLs
  
  isVerifiedPurchase Boolean @default(false)
  helpfulCount Int   @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("product_reviews")
  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
}

/// GuideBookmark model - saved guides for users
model GuideBookmark {
  id        String   @id @default(uuid())
  guideId   String
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([guideId, userId])
  @@map("guide_bookmarks")
  @@index([guideId])
  @@index([userId])
}

/// GuideComment model - user comments on guides
model GuideComment {
  id        String   @id @default(uuid())
  guideId   String
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  content   String   @db.Text
  rating    Int?     // 1-5 stars
  
  isApproved Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("guide_comments")
  @@index([guideId])
  @@index([userId])
}
